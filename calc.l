%{
#include "calc.tab.h"    /* generated by Bison; contains token definitions */
#include <stdlib.h>      /* MODIFICATION: needed for atof() */
%}

%%

[ \t]+           { /* skip spaces and tabs only */ }
[0-9]+"."[0-9]+  { yylval.fval = atof(yytext); return FNUM; }
[0-9]+           { yylval.ival = atoi(yytext); return NUM; }
#[^\n]*          { /* discard single-line comment */ }
\n               { return NEWLINE; }
"+"              { return PLUS; }
"-"              { return MINUS; }
"*"              { return TIMES; }
"/"              { return DIVIDE; }
                 /* MODIFICATION 4: caret operator for exponentiation */
"^"              { return POW; }
"("              { return LPAREN; }
")"              { return RPAREN; }
.                { fprintf(stderr, "Unknown character: %s\n", yytext); }

%%

int yywrap(void) { return 1; }
